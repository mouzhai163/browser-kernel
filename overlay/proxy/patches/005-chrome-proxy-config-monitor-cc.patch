+// In an MZ environment every network context follows the environment's proxy,
+// including the browser-wide one and Safe Browsing's. The service blocks all
+// traffic until the environment's configuration arrives.
+std::unique_ptr<net::ProxyConfigService> CreateMzProxyConfigService() {
+#if BUILDFLAG(IS_WIN)
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("mz-env-id")) {
+    return std::make_unique<mz::ProxyConfigServiceWrapper>(
+        mz::MzBrowserContext::GetInstance()->GetOrCreateProxyConfigService());
+  }
+#endif
+  return nullptr;
+}
