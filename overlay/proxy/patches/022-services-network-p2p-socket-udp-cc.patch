+
+void P2PSocketUdp::OnSocks5UdpRelayReady(int result) {
+  if (result != net::OK) {
+    LOG(ERROR) << "[MZ WebRTC] SOCKS5 UDP relay unavailable (" << result
+               << "); UDP socket closed without direct fallback.";
+    OnError();
+    return;
+  }
+  PendingInit init = std::move(*pending_init_);
+  pending_init_.reset();
+  InitSocket(init.local_address, init.min_port, init.max_port,
+             init.remote_address);
+}
+
+void P2PSocketUdp::OnSocks5UdpRelayClosed() {
+  OnError();
+}
