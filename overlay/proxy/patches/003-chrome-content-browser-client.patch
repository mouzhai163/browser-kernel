+class SimprintProxyLoginDelegate : public content::LoginDelegate {
+ public:
+  SimprintProxyLoginDelegate(
+      const net::AuthCredentials& credentials,
+      LoginAuthRequiredCallback auth_required_callback) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&SimprintProxyLoginDelegate::Respond,
+                       weak_factory_.GetWeakPtr(), credentials,
+                       std::move(auth_required_callback)));
+  }
+
+  ~SimprintProxyLoginDelegate() override = default;
+
+ private:
+  void Respond(const net::AuthCredentials& credentials,
+               LoginAuthRequiredCallback auth_required_callback) {
+    std::move(auth_required_callback).Run(credentials);
+  }
+
+  base::WeakPtrFactory<SimprintProxyLoginDelegate> weak_factory_{this};
+};
