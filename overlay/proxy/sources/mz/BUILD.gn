import("//build/config/features.gni")

# Main MZ target that aggregates all components
group("mz") {
  public_deps = [
    ":browser_context",
    "//mz/eventbus",
    "//mz/proxy",
  ]
}

source_set("browser_context") {
  sources = [
    "mz_browser_context.cc",
    "mz_browser_context.h",
  ]

  deps = [
    "//base",
    "//mz/config",
    "//mz/eventbus",
    "//mz/proxy",
  ]
}
