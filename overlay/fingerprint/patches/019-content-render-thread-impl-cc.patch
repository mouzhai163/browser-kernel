diff --git a/content/renderer/render_thread_impl.cc b/content/renderer/render_thread_impl.cc
--- a/content/renderer/render_thread_impl.cc
+++ b/content/renderer/render_thread_impl.cc
@@ -44,6 +44,8 @@
 #include "base/strings/to_string.h"
 #include "base/strings/utf_string_conversions.h"
 #include "base/synchronization/waitable_event.h"
+#include "mz/config/fingerprint_config_storage.h"
+#include "base/i18n/rtl.h"
 #include "base/task/bind_post_task.h"
 #include "base/task/sequenced_task_runner.h"
 #include "base/task/single_thread_task_runner.h"
@@ -854,7 +856,8 @@
     const std::vector<std::string>& cors_exempt_header_list,
     blink::mojom::OriginTrialsSettingsPtr origin_trials_settings,
     blink::mojom::PerformanceTier cpu_performance_tier,
-    uint64_t trace_id) {
+    uint64_t trace_id,
+    const std::string& mz_fingerprint_config) {
   TRACE_EVENT("navigation", "RenderThreadImpl::InitializeRenderer",
               perfetto::TerminatingFlow::Global(trace_id));
   DCHECK(user_agent_.IsNull());
@@ -864,6 +867,19 @@
   user_agent_metadata_ = user_agent_metadata;
   cors_exempt_header_list_ = cors_exempt_header_list;
   cpu_performance_tier_ = cpu_performance_tier;
+
+  // MZ: 导入指纹配置。导入失败就退出，不能带着默认指纹继续运行。
+  if (!mz::config::ImportAllConfigFromJson(mz_fingerprint_config)) {
+    LOG(ERROR) << "[MZ Config] Could not import the fingerprint config, exiting";
+    base::Process::TerminateCurrentProcessImmediately(1);
+  }
+
+  // 让 ICU（Intl.*、Date#toString、toLocaleString）跟随配置的语言，而不是系统区域设置：
+  // 否则脚本能通过 Intl 默认 locale 读到真实的系统语言（例如 de-DE）。
+  const std::string imported_language = mz::config::GetLanguage();
+  if (!imported_language.empty()) {
+    base::i18n::SetICUDefaultLocale(imported_language);
+  }
 
   std::vector<blink::WebString> web_cors_exempt_header_list(
       cors_exempt_header_list.size());
