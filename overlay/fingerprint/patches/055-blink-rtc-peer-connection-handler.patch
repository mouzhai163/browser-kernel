+  // MZ: 检查是否需要过滤 ICE candidates
+  std::string webrtc_mode = mz::fingerprint::NetworkLocationFingerprint::GetConfiguredWebRTCMode();
+  // 默认拒绝：只有明确配置为 "real" 才放行。空值、"disable"、未实现的 "replace"、
