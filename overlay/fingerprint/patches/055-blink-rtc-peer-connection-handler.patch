+  if (webrtc_mode != "real") {
+    if (webrtc_mode == "disable_non_proxied") {
+      // 只允许 relay 类型的候选项（通过 TURN 服务器）
+      std::string sdp_str = sdp.Utf8();
+      if (sdp_str.find("typ relay") == std::string::npos) {
+        // 不是 relay 类型，丢弃此候选项
+        return;
+      }
+    } else {
+      // 完全禁用 ICE candidates
+      return;
+    }
+  }
