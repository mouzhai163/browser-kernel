 void NavigatorLanguage::EnsureUpdatedLanguage() {
+  // MZ: 检查是否有指纹配置的语言
+  std::string configured_language =
+      mz::fingerprint::NetworkLocationFingerprint::GetConfiguredLanguage();
+  if (!configured_language.empty()) {
+    // 与 Accept-Language 头保持一致（例如 ["en-US", "en"]），而不是只放一个。
+    std::string language_list;
+    for (const std::string& language : mz::config::GetLanguageList()) {
+      language_list += (language_list.empty() ? "" : ",") + language;
+    }
+    languages_ = ParseAndSanitize(String::FromUtf8(language_list));
+    languages_dirty_ = false;
+    return;
+  }
+
   String accept_languages_override;
   probe::ApplyAcceptLanguageOverride(execution_context_,
                                      &accept_languages_override);
