 String NavigatorBase::userAgent() const {
+  // MZ: 检查是否有指纹配置的 UserAgent
+  std::string configured_ua = mz::fingerprint::NetworkLocationFingerprint::GetConfiguredUserAgent();
+  if (!configured_ua.empty()) {
+    // 直接返回配置的 UA（已经在配置层简化过了）
+    return String::FromUtf8(configured_ua);
+  }
+
+  // MZ: 如果没有配置 UA，返回 ExecutionContext 的 UA
   ExecutionContext* execution_context = GetExecutionContext();
   return execution_context ? execution_context->UserAgent() : String();
 }
 
