+            LOG(INFO) << "[MZ Language] Calling UpdateAcceptLanguage for profile";
+            service->UpdateAcceptLanguage();
+          } else {
+            LOG(WARNING) << "[MZ Language] ProfileNetworkContextService not found for profile";
+          }
+        }
