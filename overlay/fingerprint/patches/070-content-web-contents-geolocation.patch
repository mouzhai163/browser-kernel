diff --git a/content/browser/web_contents/web_contents_impl.cc b/content/browser/web_contents/web_contents_impl.cc
--- a/content/browser/web_contents/web_contents_impl.cc
+++ b/content/browser/web_contents/web_contents_impl.cc
@@ -3,6 +3,10 @@
 // found in the LICENSE file.
 
 #include "content/browser/web_contents/web_contents_impl.h"
+#include "base/strings/string_number_conversions.h"
+#include "services/device/public/cpp/geolocation/geoposition.h"
+#include "services/device/public/mojom/geoposition.mojom.h"
+#include "mz/config/fingerprint_config_storage.h"
 
 #include <stddef.h>
 
@@ -6689,6 +6693,29 @@
     GetDeviceService().BindGeolocationContext(
         geolocation_context_.BindNewPipeAndPassReceiver());
   }
+
+  // MZ: serve the configured position to every frame of this tab. Auto-granting the
+  // permission is not enough: without an OS location source the request would never
+  // complete. This runs on every call (SetOverride is idempotent) instead of only when the
+  // context is created, because the first tab's context can be created before the
+  // fingerprint config has been applied.
+  const std::string mz_geo = mz::config::GetGeolocation();
+  const size_t mz_comma = mz_geo.find(',');
+  double mz_lat = 0;
+  double mz_lon = 0;
+  if (mz_comma != std::string::npos &&
+      base::StringToDouble(mz_geo.substr(0, mz_comma), &mz_lat) &&
+      base::StringToDouble(mz_geo.substr(mz_comma + 1), &mz_lon)) {
+    auto position = device::mojom::Geoposition::New();
+    position->latitude = mz_lat;
+    position->longitude = mz_lon;
+    position->accuracy = 30;  // metres, a typical Wi-Fi based fix
+    position->timestamp = base::Time::Now();
+    if (device::ValidateGeoposition(*position)) {
+      geolocation_context_->SetOverride(
+          device::mojom::GeopositionResult::NewPosition(std::move(position)));
+    }
+  }
   return geolocation_context_.get();
 }
 
