+// Simprint: make JS Date / Intl use the configured timezone instead of the OS one.
+// Uses Blink's own override mechanism (the one behind DevTools'
+// Emulation.setTimezoneOverride): it updates ICU, notifies V8 and all workers, and
+// survives host timezone change events. Runs once per renderer process, on the
+// first window (the fingerprint config is imported before any page is created).
+void ApplyConfiguredTimeZoneOnce() {
+  static bool done = false;
+  if (done) {
+    return;
+  }
+  const std::string timezone = simprint::config::GetTimezone();
+  if (timezone.empty()) {
+    return;
+  }
+  done = true;
+  static std::unique_ptr<TimeZoneController::TimeZoneOverride>* keep_alive =
+      new std::unique_ptr<TimeZoneController::TimeZoneOverride>();
+  TimeZoneController::TimeZoneOverrideResult result =
+      TimeZoneController::SetTimeZoneOverride(String::FromUtf8(timezone));
+  if (result.handle) {
+    *keep_alive = std::move(result.handle);
+  }
+}
+
+// Simprint: make Intl / toLocaleString follow the configured language instead of the
+// OS locale. base::i18n::SetICUDefaultLocale() alone is not enough: V8 caches its
+// default locale per isolate. LocaleController (DevTools' Emulation.setLocaleOverride
+// mechanism) updates ICU, resets the cache in every main-thread isolate and all workers.
+void ApplyConfiguredLocaleOnce() {
+  static bool done = false;
+  if (done) {
+    return;
+  }
+  const std::string language = simprint::config::GetLanguage();
+  if (language.empty()) {
+    return;
+  }
+  done = true;
+  LocaleController::instance().SetLocaleOverride(String::FromUtf8(language),
+                                                 /*is_claiming_override=*/false);
+}
+
+}  // namespace
