+// MZ: the real list is the installed Windows TTS voices, which reveals the
+// machine's real UI/language packs (e.g. de-DE + zh-CN while the profile says
+// en-US). In every mode except "system" expose a stock Windows voice set that
+// matches the configured language instead.
+struct MzVoice {
+  const char* name;
+  const char* lang;
+};
+
+constexpr MzVoice kEnUsVoices[] = {
+    {"Microsoft David - English (United States)", "en-US"},
+    {"Microsoft Mark - English (United States)", "en-US"},
+    {"Microsoft Zira - English (United States)", "en-US"},
+};
+
+struct MzVoiceSet {
+  const char* language_prefix;  // matched against the configured language
+  RAW_PTR_EXCLUSION base::span<const MzVoice> voices;  // static data
+};
+
+constexpr MzVoice kEnGbVoices[] = {
+    {"Microsoft George - English (United Kingdom)", "en-GB"},
+    {"Microsoft Hazel - English (United Kingdom)", "en-GB"},
+    {"Microsoft Susan - English (United Kingdom)", "en-GB"},
+};
+constexpr MzVoice kZhCnVoices[] = {
+    {"Microsoft Huihui - Chinese (Simplified, PRC)", "zh-CN"},
+    {"Microsoft Kangkang - Chinese (Simplified, PRC)", "zh-CN"},
+    {"Microsoft Yaoyao - Chinese (Simplified, PRC)", "zh-CN"},
+};
+constexpr MzVoice kDeDeVoices[] = {
+    {"Microsoft Hedda - German (Germany)", "de-DE"},
+    {"Microsoft Katja - German (Germany)", "de-DE"},
+    {"Microsoft Stefan - German (Germany)", "de-DE"},
+};
+constexpr MzVoice kFrFrVoices[] = {
+    {"Microsoft Hortense - French (France)", "fr-FR"},
+    {"Microsoft Julie - French (France)", "fr-FR"},
+    {"Microsoft Paul - French (France)", "fr-FR"},
+};
+constexpr MzVoice kEsEsVoices[] = {
+    {"Microsoft Helena - Spanish (Spain)", "es-ES"},
+    {"Microsoft Laura - Spanish (Spain)", "es-ES"},
+    {"Microsoft Pablo - Spanish (Spain)", "es-ES"},
+};
+constexpr MzVoice kJaJpVoices[] = {
+    {"Microsoft Ayumi - Japanese (Japan)", "ja-JP"},
+    {"Microsoft Haruka - Japanese (Japan)", "ja-JP"},
+    {"Microsoft Ichiro - Japanese (Japan)", "ja-JP"},
+};
+constexpr MzVoice kKoKrVoices[] = {
+    {"Microsoft Heami - Korean (Korea)", "ko-KR"},
+};
+constexpr MzVoice kRuRuVoices[] = {
+    {"Microsoft Irina - Russian (Russia)", "ru-RU"},
+    {"Microsoft Pavel - Russian (Russia)", "ru-RU"},
+};
+constexpr MzVoice kPtBrVoices[] = {
+    {"Microsoft Maria - Portuguese (Brazil)", "pt-BR"},
+};
+constexpr MzVoice kItItVoices[] = {
+    {"Microsoft Elsa - Italian (Italy)", "it-IT"},
+    {"Microsoft Cosimo - Italian (Italy)", "it-IT"},
+};
+
+constexpr MzVoiceSet kVoiceSets[] = {
+    {"en-GB", kEnGbVoices},
+    {"zh", kZhCnVoices},
+    {"de", kDeDeVoices},
+    {"fr", kFrFrVoices},
+    {"es", kEsEsVoices},
+    {"ja", kJaJpVoices},
+    {"ko", kKoKrVoices},
+    {"ru", kRuRuVoices},
+    {"pt", kPtBrVoices},
+    {"it", kItItVoices},
+};
+
+Vector<mojom::blink::SpeechSynthesisVoicePtr> MakeMzVoices(
+    const std::string& language) {
+  Vector<mojom::blink::SpeechSynthesisVoicePtr> voices;
+  auto add = [&voices](const MzVoice& v, bool is_default) {
+    auto voice = mojom::blink::SpeechSynthesisVoice::New();
+    voice->voice_uri = String::FromUtf8(v.name);
+    voice->name = String::FromUtf8(v.name);
+    voice->lang = String::FromUtf8(v.lang);
+    voice->is_local_service = true;
+    voice->is_default = is_default;
+    voices.push_back(std::move(voice));
+  };
+  bool first = true;
+  for (const MzVoiceSet& set : kVoiceSets) {
+    if (language.rfind(set.language_prefix, 0) == 0) {
+      for (const MzVoice& v : set.voices) {
+        add(v, first);
+        first = false;
+      }
+      break;
+    }
+  }
+  // Windows always ships the en-US voices as well.
+  for (const MzVoice& v : kEnUsVoices) {
+    add(v, first);
+    first = false;
+  }
+  return voices;
+}
