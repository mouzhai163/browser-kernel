 float MediaValues::CalculateDevicePixelRatio(LocalFrame* frame) {
+  // Simprint: (resolution) / (-webkit-device-pixel-ratio) 必须和 window.devicePixelRatio 一致。
+  if (double configured =
+          simprint::fingerprint::ScreenHardwareFingerprint::GetConfiguredDevicePixelRatio();
+      configured > 0) {
+    return static_cast<float>(configured);
+  }
   return frame->DevicePixelRatio();
 }
 
