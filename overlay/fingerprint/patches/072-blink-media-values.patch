 int MediaValues::CalculateDeviceWidth(LocalFrame* frame) {
   DCHECK(frame && frame->View() && frame->GetSettings() && frame->GetPage());
+  // Simprint: 媒体查询 (device-width) 必须和 screen.width 一致，否则能读出真实显示器分辨率。
+  if (int configured =
+          simprint::fingerprint::ScreenHardwareFingerprint::GetConfiguredScreenWidth();
+      configured > 0) {
+    return configured;
+  }
