@@ -59,27 +50,6 @@
 }
 
 }  // namespace
-
-void InitializePlatformLanguage() {
-  DCHECK(IsMainThread());
-  DEFINE_STATIC_LOCAL(
-      // We add the platform language as a static string for two reasons:
-      // 1. it can be shared across threads.
-      // 2. since this is done very early on, we don't want to accidentally
