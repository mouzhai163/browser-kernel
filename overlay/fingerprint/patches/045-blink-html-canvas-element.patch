+namespace {
+
+// MZ: 给导出的快照加 Canvas 指纹噪声，toDataURL 和 toBlob 共用，两者输出才一致。
+// 在副本上改：快照可能与画布缓存共享像素，原地修改会让噪声随调用次数累积。
+scoped_refptr<StaticBitmapImage> ApplyMzCanvasNoise(
+    scoped_refptr<StaticBitmapImage> image) {
+  sk_sp<SkImage> source = image->PaintImageForCurrentFrame().GetSwSkImage();
+  if (!source) {
+    return image;
+  }
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(source->imageInfo().makeColorType(kN32_SkColorType)) ||
+      !source->readPixels(nullptr, bitmap.pixmap(), 0, 0)) {
+    return image;
+  }
+  mz::fingerprint::BrowserFingerprint::ApplyCanvasNoise(
+      static_cast<unsigned char*>(bitmap.getPixels()),
+      bitmap.computeByteSize());
+  return UnacceleratedStaticBitmapImage::Create(
+      SkImages::RasterFromBitmap(bitmap));
+}
+
