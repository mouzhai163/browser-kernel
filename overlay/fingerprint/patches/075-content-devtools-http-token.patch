+// MZ: 调试端口的访问令牌，由软件启动内核时通过环境变量传入。没有设置时不校验。
+constexpr char kMzDebugTokenEnvVar[] = "MZ_DEBUG_TOKEN";
+constexpr std::string_view kMzDebugTokenParam = "mz_token=";
+
+// 读取后从环境里清掉，否则之后启动的程序（原生消息宿主、打开下载文件等）会继承令牌。
+std::string MzTakeDebugTokenFromEnvironment() {
+  std::unique_ptr<base::Environment> environment = base::Environment::Create();
+  std::string token =
+      environment->GetVar(kMzDebugTokenEnvVar).value_or(std::string());
+  environment->UnSetVar(kMzDebugTokenEnvVar);
+  return token;
+}
+
+const std::string& MzDebugToken() {
+  static const base::NoDestructor<std::string> token(
+      MzTakeDebugTokenFromEnvironment());
+  return *token;
+}
+
+// 拼到给客户端的 WebSocket 地址后面，客户端照着地址连接就带上了令牌。
+std::string MzDebugTokenQuery() {
+  return MzDebugToken().empty()
+             ? std::string()
+             : base::StrCat({"?", kMzDebugTokenParam, MzDebugToken()});
+}
+
+bool MzDebugTokenMatches(std::string_view candidate) {
+  const std::string& expected = MzDebugToken();
+  if (candidate.size() != expected.size()) {
+    return false;
+  }
+  unsigned char difference = 0;
+  for (size_t i = 0; i < expected.size(); ++i) {
+    difference |= static_cast<unsigned char>(candidate[i] ^ expected[i]);
+  }
+  return difference == 0;
+}
+
+// 校验请求路径里的令牌并把它去掉，后面的处理看到的还是原来的路径。
+bool MzConsumeDebugToken(std::string& path) {
+  if (MzDebugToken().empty()) {
+    return true;
+  }
+  const size_t query_pos = path.find('?');
+  if (query_pos == std::string::npos) {
+    return false;
+  }
+  bool accepted = false;
+  std::vector<std::string_view> kept;
+  for (std::string_view part : base::SplitStringPiece(
+           std::string_view(path).substr(query_pos + 1), "&",
+           base::KEEP_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (part.starts_with(kMzDebugTokenParam)) {
+      accepted = MzDebugTokenMatches(part.substr(kMzDebugTokenParam.size()));
+    } else {
+      kept.push_back(part);
+    }
+  }
+  if (!accepted) {
+    return false;
+  }
+  std::string stripped = path.substr(0, query_pos);
+  if (!kept.empty()) {
+    stripped += "?" + base::JoinString(kept, "&");
+  }
+  path = std::move(stripped);
+  return true;
+}
