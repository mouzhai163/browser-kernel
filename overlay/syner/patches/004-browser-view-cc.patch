+void BrowserView::OnSyncInputWidgetInitialized(views::Widget* widget) {
+#if defined(USE_AURA)
+  if (!sync_input_capture_handler_ || !widget) {
+    return;
+  }
+  aura::Window* content = static_cast<aura::Window*>(widget->GetNativeView());
+  aura::Window* root = content ? content->GetRootWindow() : nullptr;
+  if (!root || root == native_window_for_sync_capture_) {
+    return;
+  }
+  auto it = std::ranges::find(sync_capture_transient_roots_, root);
+  if (it != sync_capture_transient_roots_.end()) {
+    size_t idx = static_cast<size_t>(it - sync_capture_transient_roots_.begin());
+    if (idx < sync_capture_transient_root_views_.size()) {
+      sync_capture_transient_root_views_[idx] = widget->GetRootView();
+    }
+    return;
+  }
+  sync_input_capture_handler_->AttachToWindow(
+      root, ui::EventTarget::Priority::kSystem);
+  sync_capture_transient_roots_.push_back(root);
+  sync_capture_transient_root_views_.push_back(widget->GetRootView());
+  if (sync_capture_popup_roots_observer_) {
+    sync_capture_popup_roots_observer_->AddRoot(root);
+  }
+#endif
+}
+
+void BrowserView::OnTransientChildWindowAdded(aura::Window* parent,
+                                             aura::Window* transient_child) {
+  if (!sync_input_capture_handler_) {
+    return;
+  }
+  // 不按 parent 过滤：Windows 上部分弹出层（如 tab 右键菜单）可能不以本窗口为
+  // transient parent 注册，故对任意新 transient 都挂 handler，仅排除主窗口根避免重复。
+  aura::Window* trans_root = transient_child->GetRootWindow();
+  if (!trans_root || trans_root == native_window_for_sync_capture_) {
+    return;
+  }
+  if (std::ranges::contains(sync_capture_transient_roots_, trans_root)) {
+    return;
+  }
+  sync_input_capture_handler_->AttachToWindow(
+      trans_root, ui::EventTarget::Priority::kSystem);
+  sync_capture_transient_roots_.push_back(trans_root);
+  sync_capture_transient_root_views_.push_back(nullptr);
+}
+
+void BrowserView::OnTransientChildWindowRemoved(aura::Window* parent,
+                                               aura::Window* transient_child) {
+  if (!sync_input_capture_handler_) {
+    return;
+  }
+  aura::Window* trans_root = transient_child->GetRootWindow();
+  if (!trans_root) {
+    return;
+  }
+  auto it = std::ranges::find(sync_capture_transient_roots_, trans_root);
+  if (it == sync_capture_transient_roots_.end()) {
+    return;
+  }
+  if (sync_capture_popup_roots_observer_) {
+    sync_capture_popup_roots_observer_->RemoveRoot(trans_root);
+    trans_root->RemoveObserver(sync_capture_popup_roots_observer_.get());
+  }
+  sync_input_capture_handler_->DetachFromWindow(trans_root);
+  size_t idx = static_cast<size_t>(it - sync_capture_transient_roots_.begin());
+  sync_capture_transient_roots_.erase(it);
+  if (idx < sync_capture_transient_root_views_.size()) {
+    sync_capture_transient_root_views_.erase(
+        sync_capture_transient_root_views_.begin() + static_cast<ptrdiff_t>(idx));
+  }
+}
+
+void BrowserView::EnsureSyncCaptureOnActiveWebContents() {
+#if defined(USE_AURA)
+  if (!sync_input_capture_handler_ || !native_window_for_sync_capture_) {
+    return;
+  }
+  content::WebContents* active = GetActiveWebContents();
+  aura::Window* target_window = nullptr;
+  if (active) {
+    gfx::NativeView nv = active->GetNativeView();
+    target_window = static_cast<aura::Window*>(nv);
+  }
+  if (target_window == sync_capture_web_contents_window_) {
+    return;
+  }
+  // 不再向 content 窗口挂 handler（root 已覆盖），避免同一按键触发两次 OnKeyEvent
+  sync_capture_web_contents_window_ = target_window;
+#endif
+}
