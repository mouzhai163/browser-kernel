+std::pair<views::View*, size_t>
+BrowserView::GetSyncCaptureRootViewAndIndexForEvent(ui::LocatedEvent* event) {
+  views::View* main_root = GetWidget() ? GetWidget()->GetRootView() : nullptr;
+#if defined(USE_AURA)
+  if (!event || !event->target() || !native_window_for_sync_capture_ ||
+      !main_root) {
+    return {main_root, 0};
+  }
+  // Aura 下事件目标为 aura::Window（RTTI 关闭故不用 dynamic_cast）；先取 root 再使用
+  aura::Window* event_window = static_cast<aura::Window*>(event->target());
+  aura::Window* root = event_window ? event_window->GetRootWindow() : nullptr;
+  if (!root) {
+    return {main_root, 0};
+  }
+  if (root == native_window_for_sync_capture_) {
+    return {main_root, 0};
+  }
+  auto it = std::ranges::find(sync_capture_transient_roots_, root);
+  if (it == sync_capture_transient_roots_.end()) {
+    return {main_root, 0};
+  }
+  size_t idx = static_cast<size_t>(it - sync_capture_transient_roots_.begin());
+  views::View* view = (idx < sync_capture_transient_root_views_.size())
+                          ? sync_capture_transient_root_views_[idx].get()
+                          : nullptr;
+  // 弹出层 Widget 未就绪或已销毁时不要返回该 view，避免后续访问崩溃
+  if (!view || !view->GetWidget()) {
+    return {main_root, 0};
+  }
+  return {view, idx + 1};
+#else
+  return {main_root, 0};
+#endif
+}
+
+std::pair<views::View*, size_t>
+BrowserView::GetSyncCaptureRootViewAndIndexForKeyEvent(ui::Event* event) {
+  views::View* main_root = GetWidget() ? GetWidget()->GetRootView() : nullptr;
+#if defined(USE_AURA)
+  if (!event || !event->target() || !native_window_for_sync_capture_ ||
+      !main_root) {
+    return {main_root, 0};
+  }
+  aura::Window* event_window = static_cast<aura::Window*>(event->target());
+  aura::Window* root = event_window ? event_window->GetRootWindow() : nullptr;
+  if (!root) {
+    return {main_root, 0};
+  }
+  if (root == native_window_for_sync_capture_) {
+    return {main_root, 0};
+  }
+  auto it = std::ranges::find(sync_capture_transient_roots_, root);
+  if (it == sync_capture_transient_roots_.end()) {
+    return {main_root, 0};
+  }
+  size_t idx = static_cast<size_t>(it - sync_capture_transient_roots_.begin());
+  views::View* view = (idx < sync_capture_transient_root_views_.size())
+                          ? sync_capture_transient_root_views_[idx].get()
+                          : nullptr;
+  if (!view || !view->GetWidget()) {
+    return {main_root, 0};
+  }
+  return {view, idx + 1};
+#else
+  return {main_root, 0};
+#endif
+}
+
+std::vector<views::View*> BrowserView::GetSyncReplayRootViews() {
+  std::vector<views::View*> out;
+  views::Widget* main_widget = GetWidget();
+  if (!main_widget) {
+    return out;
+  }
+  out.push_back(main_widget->GetRootView());
+#if defined(USE_AURA)
+  // 与主控相同：使用 TransientObserver + OnSyncInputWidgetInitialized 维护的列表，
+  // 保证主从 root_index 一一对应。GetTransientChildren 无法可靠枚举菜单等弹出层。
+  for (const raw_ptr<views::View>& v : sync_capture_transient_root_views_) {
+    out.push_back(v.get());
+  }
+#endif
+  return out;
+}
