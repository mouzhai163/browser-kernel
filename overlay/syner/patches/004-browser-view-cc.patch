+#if defined(USE_AURA)
+class BrowserView::SyncInputPopupRootsObserver : public aura::WindowObserver {
+ public:
+  SyncInputPopupRootsObserver(
+      SyncInputCaptureHandler* handler,
+      std::vector<raw_ptr<aura::Window>>* roots_ptr,
+      std::vector<raw_ptr<views::View>>* root_views_ptr)
+      : handler_(handler),
+        roots_ptr_(roots_ptr),
+        root_views_ptr_(root_views_ptr) {}
+
+  ~SyncInputPopupRootsObserver() override {
+    for (aura::Window* root : observed_roots_) {
+      if (root) {
+        root->RemoveObserver(this);
+      }
+    }
+  }
+
+  void AddRoot(aura::Window* root) {
+    if (root && observed_roots_.insert(root).second) {
+      root->AddObserver(this);
+    }
+  }
+
+  void RemoveRoot(aura::Window* root) {
+    observed_roots_.erase(root);
+  }
+
+  // aura::WindowObserver:
+  void OnWindowDestroying(aura::Window* window) override {
+    observed_roots_.erase(window);
+    if (!handler_ || !roots_ptr_) {
+      return;
+    }
+    handler_->DetachFromWindow(window);
+    auto it = std::ranges::find(*roots_ptr_, window);
+    if (it != roots_ptr_->end()) {
+      size_t idx = static_cast<size_t>(it - roots_ptr_->begin());
+      roots_ptr_->erase(it);
+      if (root_views_ptr_ && idx < root_views_ptr_->size()) {
+        root_views_ptr_->erase(root_views_ptr_->begin() +
+                              static_cast<ptrdiff_t>(idx));
+      }
+    }
+  }
+
+ private:
+  raw_ptr<SyncInputCaptureHandler> handler_;
+  raw_ptr<std::vector<raw_ptr<aura::Window>>> roots_ptr_;
+  raw_ptr<std::vector<raw_ptr<views::View>>> root_views_ptr_;
+  std::set<raw_ptr<aura::Window>> observed_roots_;
+};
+#endif  // USE_AURA
