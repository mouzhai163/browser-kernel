+// Removes the sync input capture handler from every aura window / view it was
+// attached to. Must run while those windows are still alive: since M156 the
+// BrowserView is destroyed after its NativeWidget, so doing this only in the
+// destructor touches dangling aura::Window pointers.
+void BrowserView::DetachSyncInputCapture() {
+  if (sync_input_capture_handler_) {
+#if defined(USE_AURA)
+    ChromeViewsDelegate::SetSyncInputOnWidgetInitialized(
+        ChromeViewsDelegate::SyncInputOnWidgetInitializedCallback());
+    sync_capture_popup_roots_observer_.reset();
+    aura::client::TransientWindowClient* transient_client =
+        aura::client::GetTransientWindowClient();
+    if (transient_client) {
+      transient_client->RemoveObserver(this);
+    }
+    for (aura::Window* trans_root : sync_capture_transient_roots_) {
+      if (trans_root) {
+        sync_input_capture_handler_->DetachFromWindow(trans_root);
+      }
+    }
+    sync_capture_transient_roots_.clear();
+    sync_capture_transient_root_views_.clear();
+    if (sync_capture_web_contents_window_) {
+      sync_input_capture_handler_->DetachFromWindow(
+          sync_capture_web_contents_window_);
+    }
+    sync_capture_web_contents_window_ = nullptr;
+#endif
+    if (native_window_for_sync_capture_) {
+      sync_input_capture_handler_->DetachFromWindow(
+          native_window_for_sync_capture_);
+    }
+    if (sync_capture_content_window_ &&
+        sync_capture_content_window_ != native_window_for_sync_capture_) {
+      sync_input_capture_handler_->DetachFromWindow(
+          sync_capture_content_window_);
+    }
+    if (!native_window_for_sync_capture_ && root_view_for_sync_capture_) {
+      root_view_for_sync_capture_->RemovePreTargetHandler(
+          sync_input_capture_handler_.get());
+    }
+  }
+  sync_input_capture_handler_.reset();
+  root_view_for_sync_capture_ = nullptr;
+  native_window_for_sync_capture_ = nullptr;
+  sync_capture_content_window_ = nullptr;
+}
